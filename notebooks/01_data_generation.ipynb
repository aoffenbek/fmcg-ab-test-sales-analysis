import numpy as np
import pandas as pd


np.random.seed(42)


n_days = 60
n_stores = 20


stores = [f"Store_{i}" for i in range(1, n_stores + 1)]
dates = pd.date_range(start="2024-01-01", periods=n_days)


data = []


for store in stores:
group = "discount" if int(store.split('_')[1]) <= 10 else "control"
base_sales = np.random.normal(10000, 1200, n_days)
if group == "discount":
base_sales *= np.random.normal(1.08, 0.03, n_days)
for date, sales in zip(dates, base_sales):
data.append([store, date, group, round(sales, 2)])


sales_df = pd.DataFrame(data, columns=["store", "date", "group", "daily_sales"])


sales_df.head()
